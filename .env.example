# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-2.5-flash

# Catalog & vector store
CATALOG_PATH=data/shl_product_catalog.json
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=BAAI/bge-small-en-v1.5
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-small

# API
MAX_RECOMMENDATIONS=10
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://your-app.netlify.app

# Frontend (Netlify build)
VITE_API_URL=http://localhost:8000